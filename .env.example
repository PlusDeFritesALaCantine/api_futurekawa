DATABASE_URL=postgresql://futurekawa:futurekawa@postgres:5432/futurekawa
API_PORT=8001

# Dispositif d'alertes (cahier des charges III.4) — voir MQTT_Broker/docker-compose.yml
# pour le faux serveur SMTP local (Mailpit, UI sur http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=alertes@futurekawa.local
